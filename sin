flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid #edf0f4}.product small{color:#7a8497}.actions{display:flex;gap:8px;margin-top:14px}.locked{color:#0f9f73;font-size:12px}.steps{display:flex;gap:8px;flex-wrap:wrap}.step{padding:8px 10px;background:#f2f4f7;border-radius:8px;font-size:13px}.step.done{background:#e7fff6;color:#087f5b}.cartrow{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #edf0f4}.danger{color:#d92d20}.success{color:#087f5b;background:#e7fff6;padding:10px;border-radius:9px}.hidden{display:none}.console{background:#101827;color:#d8e0ed;border-radius:12px;padding:16px;font:13px/1.8 ui-monospace,monospace;max-height:330px;overflow:auto}.switch{display:flex;gap:8px;margin-bottom:16px}.switch button{padding:9px 13px;border-radius:8px;background:#f0f2f5}.switch button.on{background:#111827;color:#fff}@media(max-width:900px){.side{width:70px}.brand{font-size:0}.brand span{font-size:18px}.nav button{font-size:0}.main{margin-left:70px;width:calc(100% - 70px);padding:20px}.cards,.req,.plans{grid-template-columns:1fr 1fr}}
